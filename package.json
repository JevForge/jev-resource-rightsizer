{
  "name": "jev-resource-rightsizer",
  "version": "0.1.10",
  "description": "Recommend scale-down, keep, scale-up, or review from metrics for your CI/CD workflow.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "github-actions",
    "jev",
    "typesafe",
    "finops",
    "rightsizing",
    "cloudwatch",
    "prometheus",
    "ci-cd",
    "jevforge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JevForge/jev-resource-rightsizer.git"
  },
  "bugs": {
    "url": "https://github.com/JevForge/jev-resource-rightsizer/issues"
  },
  "homepage": "https://github.com/JevForge/jev-resource-rightsizer#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@aws-sdk/client-cloudwatch": "^3.901.0",
    "ai": "^7.0.113",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
